@@ -288,6 +288,43 @@ class AddControlInputDepth(Augmentor):
         return data_dict
 
 
+class AddControlInputFlightgrid(Augmentor):
+    """FlightGrid control input: a pre-rendered control video (see
+    worldslider/flightgrid/render.py), resized to the RGB frame size and
+    otherwise passed through unchanged. The colours of the line art carry
+    meaning (red = ground, blue = ceiling, white = flight trace), so no
+    recolouring or masking is applied here, unlike the segmentation input.
+    Registered in CTRL_HINT_KEYS below and in configs/.../conditioner.py.
+    """
+
+    def __init__(
+        self,
+        input_keys: list,
+        output_keys: Optional[list] = ["control_input_flightgrid"],
+        args: Optional[dict] = None,
+        **kwargs,
+    ) -> None:
+        super().__init__(input_keys, output_keys, args)
+
+    def __call__(self, data_dict: dict) -> dict:
+        if "control_input_flightgrid" in data_dict:
+            # already processed
+            return data_dict
+
+        key_out = self.output_keys[0]
+        flightgrid = data_dict["flightgrid"]
+
+        frames = data_dict["video"]
+        _, T, H, W = frames.shape
+        flightgrid = transforms_F.resize(
+            flightgrid,
+            size=(H, W),
+            interpolation=transforms_F.InterpolationMode.BILINEAR,
+        )
+        data_dict[key_out] = flightgrid
+        return data_dict
+
+
